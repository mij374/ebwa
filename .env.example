# EBWA website — example environment file
#
# Copy to .env for LOCAL DEVELOPMENT ONLY:
#
#     cp .env.example .env
#
# .env is gitignored and is read at startup if it exists. It never
# overrides a variable that is already set, and it is ignored entirely
# when absent, so it changes nothing on a server.
#
# PRODUCTION SECRETS DO NOT LIVE HERE. On the VPS they are in
# /etc/ebwa/env, owned root:www-data and mode 640, read by systemd via
# EnvironmentFile — see README → Production deployment.
#
# Every variable the app reads is listed below. All of them are optional:
# each one has a working default, and the site starts with none of them
# set (with email, payments and NAS transfers switched off accordingly).

# ---------------------------------------------------------------- core
# Signs the login session cookie. Any long random string will do locally;
# on the server it must be a real secret, and changing it logs everyone
# out.
SECRET_KEY='dev-only-change-me'

# Where the database lives. The default is instance/ebwa.db beside the
# app; tests point this at a throwaway file instead.
# DATABASE_URL='sqlite:///instance/ebwa.db'

# ------------------------------------------------------------- payments
# Stripe TEST keys locally — they start sk_test_ and whsec_. Live keys
# belong on the server and nowhere else.
STRIPE_SECRET_KEY='sk_test_your-test-key'
STRIPE_WEBHOOK_SECRET='whsec_your-test-webhook-secret'

# ---------------------------------------------------------------- email
# Outgoing mail: the contact form notification, and security alerts.
# With no SMTP_HOST the site still saves every enquiry — it just cannot
# email anybody about them, and says so on the Settings page.
#
# Host, port, username, encryption, from and to can all be set on
# Settings → Email instead, which overrides what is here. The PASSWORD
# cannot: it is only ever read from the environment.
SMTP_HOST='smtp.example.net'
SMTP_PORT='587'                 # 587 for STARTTLS, 465 for SSL/TLS
SMTP_USER='website@example.net'
SMTP_PASSWORD='your-mail-password'
SMTP_USE_TLS='1'                # 1 for STARTTLS, 0 for an open relay
MAIL_FROM='website@example.net'  # the address email is sent from
MAIL_TO='you@example.net'        # where enquiries go unless Settings says otherwise

# --------------------------------------------------------------- backups
# Where backup archives are written, and how many to keep on this
# machine. The default is backups/ beside the app.
# BACKUP_DIR='backups'
# BACKUP_KEEP='7'

# Encrypts the NAS password stored in the database. Needed only if you
# are testing the NAS transfer locally. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it means the stored NAS password can no longer be
# read — type a new one into Settings and save.
FERNET_KEY=''

# ------------------------------------------------------------ deployment
# NOTHING reads or writes these paths. They exist so the admin can print
# accurate instructions — today the "How to add a domain to this site"
# box on Settings — rather than confidently telling somebody the wrong
# path. Set them if this install lives somewhere other than the defaults.
# DEPLOY_ENV_FILE='/etc/ebwa/env'
# DEPLOY_PATH='/opt/ebwa'
# DEPLOY_SERVICE='ebwa'
# DEPLOY_USER='www-data'
# The nginx server block for this site. Defaults to sites-available/
# named after DEPLOY_SERVICE, which is Debian's convention.
# DEPLOY_NGINX_SITE='/etc/nginx/sites-available/ebwa'
